# Copy to .env (which is gitignored) or export these in your shell.
# ExitOS never writes credentials to plans, state, logs or reports.
#
# Only needed for LIVE runs. `exitos demo` needs NO credentials and makes NO network requests.
#
# After filling this in, check your setup (nothing is sent anywhere):  exitos doctor --live
# Add --online to also prove both tokens work with read-only calls.

# Notion internal connection API token. Create one in the Notion Developer portal
# (https://app.notion.com/developers/connections → Internal connections → Configuration tab).
# Give it the "Read content" capability ONLY (ExitOS never writes to Notion), add
# "Read user information" only if you want names/e-mails, and share just the pages/databases you
# want to migrate with it. Prefer this over a personal access token, which inherits all of your
# own page permissions.
NOTION_TOKEN=

# ClickUp personal API token, starts with pk_. See https://developer.clickup.com/docs/authentication
# ("Personal token"). It acts as you, so use a token from a test Workspace for your first runs.
CLICKUP_API_TOKEN=

# Optional: where ExitOS keeps its local SQLite state, plans and reports (default ./.exitos)
# EXITOS_STATE_DIR=./.exitos

# Optional, for testing against a local mock server ONLY (loopback hosts are accepted; any other
# host is rejected so a stray variable cannot redirect your token elsewhere).
# NOTION_API_BASE_URL=http://127.0.0.1:4010
# CLICKUP_API_BASE_URL=http://127.0.0.1:4011

# Behind a corporate proxy? HTTPS_PROXY, NO_PROXY and NODE_EXTRA_CA_CERTS are read from your real
# environment only, never from this file (so a shared .env cannot redirect traffic). Set them in your
# shell before running exitos. See docs/enterprise-readiness.md.
